{
  "name": "chordv",
  "private": true,
  "version": "1.1.12",
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "dev": "node scripts/mygo-local.mjs",
    "dev:local": "node scripts/mygo-local.mjs",
    "dev:desktop": "node scripts/mygo-desktop.mjs --dev",
    "dev:mac": "node scripts/mygo-desktop.mjs --dev",
    "dev:admin": "pnpm --filter @chordv/admin dev",
    "build": "pnpm build:server && pnpm build:desktop",
    "build:web": "pnpm --filter @chordv/shared build && pnpm --filter @chordv/admin build && pnpm --filter @chordv/desktop build",
    "build:server": "node scripts/mygo-build-backend.mjs",
    "build:desktop": "node scripts/mygo-desktop.mjs --build-only",
    "check": "pnpm --filter @chordv/shared check && pnpm --filter @chordv/admin check && pnpm --filter @chordv/desktop check && node scripts/mygo-verify.mjs --check",
    "lint": "pnpm check",
    "check:local": "node --test scripts/mygo-local-config.test.mjs scripts/mygo-local-db.test.mjs",
    "check:desktop": "node scripts/mygo-desktop.mjs --check",
    "test": "node scripts/mygo-verify.mjs",
    "test:api": "node scripts/mygo-verify.mjs",
    "test:e2e:agent": "node scripts/mygo-agent-e2e.mjs",
    "test:browser": "node scripts/mygo-verify.mjs --browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "effect": ">=3.20.0",
      "defu": ">=6.1.5",
      "qs": ">=6.15.2"
    }
  }
}
