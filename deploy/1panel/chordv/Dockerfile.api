FROM node:20.19.0-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.3 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN pnpm install --filter @chordv/api... --frozen-lockfile

COPY apps/api apps/api
COPY packages/shared packages/shared
COPY scripts/prisma-migrate-with-baseline.mjs scripts/prisma-migrate-with-baseline.mjs

RUN pnpm --filter @chordv/shared build \
  && pnpm --filter @chordv/api db:generate \
  && pnpm --filter @chordv/api build

ENV NODE_ENV=production
ENV CHORDV_API_PORT=3000
# Production must provide CHORDV_PANEL_PASSWORD_MASTER_KEY (32-byte hex/base64) at runtime.

EXPOSE 3000

# Pre-existing db-push databases are baselined before migrate deploy.
CMD ["sh", "-c", "node scripts/prisma-migrate-with-baseline.mjs && node apps/api/dist/apps/api/src/main.js"]
