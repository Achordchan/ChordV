DATABASE_URL="postgresql://chordv:chordv@localhost:54329/chordv?schema=public"
CHORDV_API_PORT=3000
CHORDV_API_BASE_URL="http://localhost:3000"
CHORDV_JWT_SECRET="change-me-in-production"

# Supervisor layout (Docker image defaults shown; no effect in ordinary local dev).
# The 1Panel compose environment FIXES these paths, overriding legacy .env values.
# Host mounts: ./api-state (private), ./api-public-state (approved version marker only),
# ./api-backups (database dumps, API-only). Never share backups/private state with nginx.
# Direct docker run/custom deployments must supply distinct persistent bind mounts.
# CHORDV_SYSTEM_STATE_DIR=/app/state
# CHORDV_SYSTEM_PUBLIC_STATE_DIR=/app/public-state
# CHORDV_SYSTEM_UPDATE_BACKUP_DIR=/app/backups
# Preserve legacy api-state/backups until verified manual archival; see README deployment.

# Panel password encryption (required in production unless CHORDV_ALLOW_PLAINTEXT_PANEL_PASSWORD=true)
# Prefer a 32-byte key encoded as 64-char hex. You can generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHORDV_PANEL_PASSWORD_MASTER_KEY=""

# Prisma migrate baseline:
# Init comparison uses apps/api/prisma/schema.init.prisma via --to-schema-datamodel (no shadow DB required).
# Emergency only: CHORDV_PRISMA_FORCE_BASELINE=true baselines ONLY the init migration.
# CHORDV_PRISMA_FORCE_BASELINE=false
# CHORDV_SKIP_MIGRATION_BASELINE_CHECK=false
# Optional alias accepted by the same crypto helper:
# CHORDV_SECRET_ENCRYPTION_KEY=""
# CHORDV_ALLOW_PLAINTEXT_PANEL_PASSWORD=false
# CHORDV_SKIP_PANEL_PASSWORD_BACKFILL=false

CHORDV_DEV_BOOTSTRAP=true
CHORDV_PANEL_DEFAULT_URL="https://example.com:34567"
CHORDV_PANEL_DEFAULT_USERNAME=""
CHORDV_PANEL_DEFAULT_PASSWORD=""
CHORDV_PANEL_DEFAULT_API_BASE_PATH="/panel"
CHORDV_PANEL_DEFAULT_TIMEOUT_MS=10000
CHORDV_XUI_TIMEOUT_MS=30000
CHORDV_PANEL_ALLOW_INSECURE_TLS=false
CHORDV_DEMO_PANEL_CLIENT_EMAIL=""
CHORDV_PANEL_SYNC_AUTOSTART=true
CHORDV_PANEL_SYNC_INTERVAL_MS=300000
CHORDV_PANEL_SYNC_BOOT_DELAY_MS=15000
# 供 Agent 一键安装脚本使用的公网源站：必须是裸 origin（无路径/查询），
# 且非本机地址必须 https —— 安装脚本会从这里下载可执行安装包，Agent 自身
# 也拒绝远程 http 的 API 地址。留空时回退到请求头推导，同样受该策略约束。
CHORDV_PUBLIC_BASE_URL="https://v.baymaxgroup.com"
CHORDV_RELEASE_STORAGE_ROOT="/www/wwwroot/chordv/releases"
CHORDV_RELEASE_MAX_UPLOAD_BYTES=1073741824
# Node-agent onboarding: where agent install tarballs
# (chordv-agent-linux-x64.tar.gz / chordv-agent-linux-arm64.tar.gz) are dropped
# for the /api/agent-download route. The 1Panel compose fixes the container path
# (/app/agent-dist) and mounts ./api-agent-dist; standalone deployments set this.
CHORDV_AGENT_DIST_DIR="/app/agent-dist"
# Xray binaries for the same install script (xray-linux-x64.tar.gz plus a
# matching .sha256, and the arm64 pair). Served from THIS origin so an install
# trusts exactly one host; unset means the install script aborts instead of
# falling back to another download source.
CHORDV_XRAY_DIST_DIR="/app/xray-dist"
# Backend self-update stable feed; override for a fork or separately managed release source.
CHORDV_SYSTEM_UPDATE_MANIFEST_URL="https://raw.githubusercontent.com/Achordchan/ChordV/backend-manifest/latest.json"
# Optional base64 DER/SPKI Ed25519 public key; required to authenticate mirrored manifests.
CHORDV_SYSTEM_UPDATE_MANIFEST_PUBLIC_KEY=""

CHORDV_SUBSCRIPTION_ALLOW_INSECURE_TLS=false

# Whose X-Forwarded-For entries the API trusts (express/proxy-addr terms).
# The 1Panel deployment chains two appending proxies (openresty → admin nginx →
# api); agents dial in from public addresses, and the default trusts only the
# private perimeter those proxies live in. Narrow for your topology or set
# "false" to trust nothing but the socket. whoami (node serverHost detection)
# depends on this being right.
# CHORDV_API_TRUSTED_PROXIES=""

# Support ticket attachment upload controls
CHORDV_SUPPORT_TICKET_ATTACHMENT_TOKEN_TTL_MS=1800000
CHORDV_SUPPORT_TICKET_ATTACHMENT_UPLOAD_RATE_LIMIT=20
CHORDV_SUPPORT_TICKET_ATTACHMENT_UPLOAD_RATE_WINDOW_MS=3600000
CHORDV_SUPPORT_TICKET_ATTACHMENT_DAILY_BYTES_LIMIT=52428800

# 已入账批次的原始载荷保留期（天）。载荷入账后只剩取证价值，此前从不回收：
# 一个 17 用户的部署 41 天累积了 702,765 行 / 1656 MB，占整库 98.6%，其中载荷 871 MB。
# 只清空 payload 字段，行本身保留 —— 确认水位线可能回退到 0，删行会造成永久缺口。
CHORDV_USAGE_PAYLOAD_RETENTION_DAYS=30
# 已解决的计量异常保留期（天）。open 状态的异常是活状态，永不清理。
CHORDV_METERING_INCIDENT_RETENTION_DAYS=90
