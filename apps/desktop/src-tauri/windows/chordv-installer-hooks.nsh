!macro NSIS_HOOK_PREINSTALL
  nsExec::ExecToLog 'powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference = ''SilentlyContinue''; Get-Process chordv-desktop,ChordV | Stop-Process -Force; Get-Process xray | Where-Object { $_.Path -like ''*app.chordv.desktop*runtime*bin*xray.exe'' } | Stop-Process -Force; $key = ''HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings''; $proxy = Get-ItemProperty $key; if ($proxy.ProxyEnable -eq 1 -and $proxy.ProxyServer -eq ''127.0.0.1:17890'') { Set-ItemProperty $key ProxyEnable 0; Set-ItemProperty $key ProxyServer ''''; Add-Type -MemberDefinition ''[DllImport("wininet.dll", SetLastError = true)] public static extern bool InternetSetOption(IntPtr hInternet, int dwOption, IntPtr lpBuffer, int dwBufferLength);'' -Name WinInetNative -Namespace ChordVInstaller; [ChordVInstaller.WinInetNative]::InternetSetOption([IntPtr]::Zero, 39, [IntPtr]::Zero, 0) | Out-Null; [ChordVInstaller.WinInetNative]::InternetSetOption([IntPtr]::Zero, 37, [IntPtr]::Zero, 0) | Out-Null }"'
!macroend
