[Unit]
Description=ChordV Node Agent
After=network-online.target xray.service
Wants=network-online.target
Requires=xray.service

[Service]
Type=simple
User=chordv-agent
Group=chordv-agent
WorkingDirectory=/opt/chordv-node-agent
EnvironmentFile=/etc/chordv/node-agent.env
ExecStart=/usr/bin/node /opt/chordv-node-agent/dist/src/main.js
ExecStartPre=/usr/bin/node --version
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chordv-node-agent
# The handoff request directory only; results are root's and stay read-only
# here. Optional ("-"): this unit is installed by deploy/install-systemd.sh,
# which provisions only the state directory above — the handoff directory is
# created by the Xray installer, and a hard requirement would stop systemd
# from setting up the mount namespace on hosts that manage users without
# inbound deployment. The control-plane installer renders its own unit with
# the requirement intact, because that installer creates the directory.
ReadWritePaths=-/var/lib/chordv-xray/requests

[Install]
WantedBy=multi-user.target
